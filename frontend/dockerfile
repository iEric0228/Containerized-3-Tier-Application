# Multi-stage build for optimized production React app
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Copy source code
COPY . .

# Build the React application
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine AS production

# Copy Nginx template
COPY nginx.conf.template /etc/nginx/nginx.conf.template

# Copy built React app from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Create non-root user for security and fix permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    chown -R nextjs:nodejs /usr/share/nginx/html && \
    chown -R nextjs:nodejs /var/cache/nginx && \
    chown -R nextjs:nodejs /var/log/nginx && \
    chown -R nextjs:nodejs /etc/nginx/conf.d && \
    chown -R nextjs:nodejs /tmp && \
    mkdir -p /var/run && \
    chown -R nextjs:nodejs /var/run && \
    mkdir -p /home/nextjs && \
    chown -R nextjs:nodejs /home/nextjs

# Set default environment variable for local development
ENV name_prefix=""

# Create entrypoint script to substitute variables (write to /tmp instead of /etc/nginx)
RUN echo '#!/bin/sh' > /docker-entrypoint-custom.sh && \
    echo 'if [ -z "$name_prefix" ]; then' >> /docker-entrypoint-custom.sh && \
    echo '  # For local development, use just "backend"' >> /docker-entrypoint-custom.sh && \
    echo '  sed "s/backend\.\${name_prefix}\.local/backend/g" /etc/nginx/nginx.conf.template > /tmp/nginx.conf' >> /docker-entrypoint-custom.sh && \
    echo 'else' >> /docker-entrypoint-custom.sh && \
    echo '  # For AWS, substitute the name_prefix' >> /docker-entrypoint-custom.sh && \
    echo '  envsubst '"'"'${name_prefix}'"'"' < /etc/nginx/nginx.conf.template > /tmp/nginx.conf' >> /docker-entrypoint-custom.sh && \
    echo 'fi' >> /docker-entrypoint-custom.sh && \
    echo 'exec nginx -g "daemon off;" -c /tmp/nginx.conf' >> /docker-entrypoint-custom.sh && \
    chmod +x /docker-entrypoint-custom.sh && \
    chown nextjs:nodejs /docker-entrypoint-custom.sh

# Switch to non-root user
USER nextjs

# Expose port 80
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:80/health || exit 1

CMD ["/docker-entrypoint-custom.sh"]